{
  "name": "shopping-compare",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --d1=shopping-compare-production --local --ip 0.0.0.0 --port 3000",
    "build": "vite build && node -e \"const fs=require('fs');fs.writeFileSync('dist/_routes.json',JSON.stringify({version:1,include:['/*'],exclude:['/static/*','/favicon.ico','/favicon.svg','/manifest.json']}))\"",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name shopping-compare",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:create": "wrangler d1 create shopping-compare-production",
    "db:migrate:local": "wrangler d1 migrations apply shopping-compare-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply shopping-compare-production",
    "db:seed:local": "wrangler d1 migrations apply shopping-compare-production --local",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "db:console": "wrangler d1 execute shopping-compare-production --local",
    "kv:create": "wrangler kv:namespace create CACHE",
    "kv:create:preview": "wrangler kv:namespace create CACHE --preview"
  },
  "dependencies": {
    "hono": "^4.12.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
