{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopping-compare",
  "compatibility_date": "2026-04-13",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],

  // Smart Placement: Cloudflare executa o Worker no datacenter mais próximo
  // da origem das requisições de saída (ex: api.mercadolibre.com → Brasil)
  "placement": { "mode": "smart" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "243c6fd8-7f60-44b1-a6d4-d70221b634ec"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "81f0b165fc0c4669a1d45c9c267de55e",
      "preview_id": "81f0b165fc0c4669a1d45c9c267de55e"
    }
  ],

  // Cron Triggers não são suportados em Pages — usar endpoint HTTP externo
  // /api/cron/shopee-refresh chamado por cron.org ou similar a cada 1h

}
